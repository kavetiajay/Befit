# Supabase Configuration
# Replace these values in your local/production environment settings.
# Do NOT commit your actual keys or secrets to Git.

# Your Supabase Project URL (e.g., https://xyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Your Supabase Publishable/Anon API key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Supabase Server-Only Secret / Service Role Key (never prefix with NEXT_PUBLIC_ and never expose to client)
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Trainer Registration Passcode (configure a strong secret in production)
TRAINER_REGISTRATION_SECRET=your_trainer_registration_secret

# Allowed Frontend Origins for CORS (comma-separated list of URLs, e.g. https://befit.vercel.app,https://admin.befitgym.com)
CORS_ALLOWED_ORIGINS=https://your_production_frontend_domain.com

# Public Frontend URL (used for client invitation links and auth redirects, e.g. https://befit.vercel.app)
FRONTEND_URL=https://your_production_frontend_domain.com

