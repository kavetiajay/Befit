# Supabase Configuration
# Replace these values in your local .env file.
# Do NOT commit your actual keys to Git.

# Your Supabase Project URL (e.g., https://xyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Your Supabase Publishable/Anon API key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Supabase Server-Only Secret Key (never prefix with NEXT_PUBLIC_ and never expose to client)
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Trainer Registration Passcode (optional, defaults to befit_trainer_2026)
TRAINER_REGISTRATION_SECRET=your_trainer_registration_secret
